{
  "name": "ai-growth-operator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "prisma generate",
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "seed": "node --conditions react-server --import tsx prisma/seed.ts",
    "smoke": "node --conditions react-server --import tsx scripts/smoke.ts",
    "check:boundary": "node scripts/check-client-boundary.mjs",
    "check:accounts": "node --conditions react-server --import tsx scripts/check-account-boundary.mts",
    "test:contracts": "node --conditions react-server --import tsx --test tests/recipes.test.ts tests/governance.test.ts tests/measurement.test.ts tests/chat.test.ts",
    "test:security": "node --conditions react-server --import tsx --test tests/export-privacy.test.ts tests/account-isolation.test.ts",
    "test:quality": "npm run lint && npm run check:boundary && npx tsc --noEmit",
    "test": "npm run lint && npm run build && node scripts/smoke.mjs && npm run test:security",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-d1": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "next": "16.2.10",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "wrangler": "^4.108.0"
  }
}
